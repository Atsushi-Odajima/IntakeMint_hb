{
  "name": "intakemint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IntakeMint — AIヒアリング・情報回収・提出物整理ツール",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "restore": "tsx scripts/restore.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "tsx scripts/perf.ts",
    "icons": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
