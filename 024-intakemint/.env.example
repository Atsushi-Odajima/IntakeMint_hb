# IntakeMint configuration (copy to .env or set in your host). Never commit real secrets.
NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://intake.example.com
# 32+ random chars. Rotating it invalidates outstanding signed file URLs (sessions/links are unaffected).
SIGNING_SECRET=change-me-to-a-long-random-string-0123456789
# PostgreSQL (production). If unset, embedded PGlite is used (dev/demo, single node).
DATABASE_URL=postgres://intakemint:password@db-host:5432/intakemint
# PGLITE_DIR=./data/pg
# Object storage: local filesystem by default; set S3_* for S3 / Cloudflare R2 / MinIO.
STORAGE_DIR=./data/objects
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=intakemint
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=50
CLIENT_LINK_DAYS=14
SIGNED_URL_TTL=300
SESSION_TTL_HOURS=168
# AI: "local" (default, no external transfer) or "anthropic". External calls require AI_ALLOW_EXTERNAL=true
# AND a documented customer agreement (see PRIVACY.md).
AI_PROVIDER=local
# AI_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
AI_ALLOW_EXTERNAL=false
# Email: "outbox" records locally and never sends. Real sending needs provider + key + EMAIL_ALLOW_REAL_SEND=true.
EMAIL_PROVIDER=outbox
# EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_ALLOW_REAL_SEND=false
# Malware scanning: none (EICAR test signature only) or clamav (clamd over TCP, separate service)
SCANNER=none
# CLAMAV_HOST=clamav
ALLOW_SIGNUP=false
TRUST_PROXY=true
RATE_LIMIT_MAX=600
LOGIN_RATE_MAX=10
# SEED_SAMPLE=true   # demo only — never on a production tenant
